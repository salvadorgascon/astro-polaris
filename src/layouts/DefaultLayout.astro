---
import { Font } from 'astro:assets';

import '@/assets/styles/global.css';

import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { ClientRouter } from 'astro:transitions';

import Favicon from '@/components/layout/Favicon.astro';

import Top from '@/components/layout/Top.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Bottom from '@/components/layout/Bottom.astro';

---
<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />		
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
		<Font cssVariable="--font-display-family" preload />
		<Font cssVariable="--font-body-family" preload />
		<Analytics />
		<SpeedInsights />
		<Favicon />
		<ClientRouter fallback="animate" />
	</head>
	<body class="min-h-screen antialiased">		
		<Top />
		<Header />
		<slot />
		<Footer />
		<Bottom />
	</body>
</html>