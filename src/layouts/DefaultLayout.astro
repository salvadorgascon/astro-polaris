---
import { Font } from 'astro:assets';

import '@/styles/global.css';

import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { ClientRouter } from 'astro:transitions';

import Favicon from '@/components/layout/Favicon.astro';

import Top from '@/components/layout/Top.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Bottom from '@/components/layout/Bottom.astro';

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description, lang = 'en' } = Astro.props;

const canonical = Astro.url.href;
---
<!doctype html>
<html lang={lang} class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />		
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonical} />
		<slot name="seo"/>		
		<title>{title}</title>
		<meta name="description" content={description} />		
		<Font cssVariable="--font-display-family" preload />
		<Font cssVariable="--font-body-family" preload />
		<Favicon />
		<Analytics />
		<SpeedInsights />		
		<ClientRouter fallback="animate" />
	</head>
	<body class="min-h-screen antialiased flex flex-col ">		
		<Top />
		<Header />
		<main class="flex-1 py-10">
			<div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
				<slot />
			</div>
		</main>		
		<Footer />
		<Bottom />
	</body>
</html>