---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  alt: string;
}

const { image, alt } = Astro.props;
---
<div class="grid grid-cols-1 gap-4 my-10 md:grid-cols-2">
  <div class="order-1 relative overflow-hidden rounded-xl ring-1 ring-black/10 aspect-4/3 md:order-1 md:aspect-16/10">
    <Image src={image} alt={alt} class="absolute inset-0 h-full w-full object-cover object-center" />
  </div>  
  <div class="order-2 md:order-2">
    <slot />
  </div>  
</div>
