---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  class?: string;  
  image: ImageMetadata;
  alt: string;
}

const { image, alt, class: className = '' } = Astro.props;
---
<div class:list={['relative overflow-hidden rounded-xl ring-1 ring-black/10', className]}
>
  <Image src={image} alt={alt} class="block w-full h-auto"/>
</div>
