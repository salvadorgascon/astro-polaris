---
interface Props {
  id: string;
}

const { id } = Astro.props;
---
<button
  id={id}
  type="button"
  class="py-4 px-7 rounded-lg border border-accent-soft hover:border-accent-emphasis text-base leading-[1.1] tracking-[0.02em] md:text-[17px] lg:text-lg font-semibold text-link uppercase flex items-center justify-center"><slot/></button>
