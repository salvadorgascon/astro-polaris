---
interface Props {
  url: string;
  hint?: string;
  openInNewTab?: boolean;
  class?: string;
}

const { url, openInNewTab = false, class: className = '', hint } = Astro.props;
---
<a 
  href={url}
  target={openInNewTab ? "_blank" : undefined}
  rel={openInNewTab ? "noopener noreferrer" : undefined}
  title={hint}
  class:list={['text-link hover:text-link-accent underline-offset-4 hover:underline', className]}><slot/></a>
