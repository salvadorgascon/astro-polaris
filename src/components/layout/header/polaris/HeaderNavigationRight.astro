---
import { getLocaleFromUrl, useTranslations } from '@/utils/polaris/localization';
import Brand from '@/components/layout/header/parts/polaris/Brand.astro';

import PrimaryNavigation from '@/components/navigation/PrimaryNavigation.astro';
import PrimaryNavigationMobile from '@/components/navigation/PrimaryNavigationMobile.astro';
import MainMenuMobileIcon from '@/components/navigation/MainMenuMobileIcon.astro';
import LanguageSwitcher from '@/components/navigation/LanguageSwitcher.astro';
import { siteSettings } from '@/config/site/settings';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const hasMultipleLocales = siteSettings.locales.length > 1;
---
<div class="sticky top-0 z-50 bg-page py-5">
  <div class="mx-auto w-full max-w-7xl px-4">
    <header>
      <div class="flex items-start justify-between gap-6 lg:grid lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end lg:gap-10">
        <Brand/>        

        <!-- Hamburger button: mobile only -->
        <button
          id="menu-button"
          type="button"
          class="inline-flex items-center justify-center rounded-md p-2 lg:hidden"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={t.polaris.components.headerNavigationRight.openMenu}
        >
          <MainMenuMobileIcon/>
        </button>
        <PrimaryNavigation/>        
        {hasMultipleLocales && <LanguageSwitcher />}
      </div>      
      <PrimaryNavigationMobile/>
    </header>
  </div>
</div>

<script is:inline>
  const button = document.getElementById('menu-button');
  const menu = document.getElementById('mobile-menu');

  if (button && menu) {
    // Toggles the mobile menu and exposes its state to assistive technologies.
    button.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden');
      button.setAttribute('aria-expanded', String(!isOpen));
    });
  }
</script>
