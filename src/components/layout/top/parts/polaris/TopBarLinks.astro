---
import { getLocaleFromUrl, useTranslations } from '@/utils/polaris/localization';
import { navigation } from '@/config/site/navigation';
import { siteSettings } from '@/config/site/settings';
import type { NavigationLink } from '@/config/types/navigation.types';
import { ui } from '@/i18n/ui';

import LinkText from '@/components/ui/links/LinkText.astro';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

---
<div class="ml-auto flex items-center gap-2">
  {/* Renders each localized top-bar link with separators. */}
  {Object.entries(navigation.en.top).map(([key, link], index) => {
    return (
      <Fragment>
        {index > 0 && <p> • </p>}
        <span><LinkText url={link.route}>{link.label}</LinkText></span>
      </Fragment>
    );
  })}
</div>
